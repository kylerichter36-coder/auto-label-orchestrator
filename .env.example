# Auto-Label Orchestrator Environment Configuration

# Gemini API Keys (comma-separated pool for automatic 429 failover & rate-limit rotation)
# Obtain free keys from https://aistudio.google.com/
GEMINI_API_KEYS=your_primary_api_key_here,your_backup_key_2,your_backup_key_3

# Network & SMTP Server Configuration
# Direct Ethernet tethered IP for Orange Pi
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
DIRECT_ETH_IP=192.168.50.1

# Web Management Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Argox Thermal Printer Configuration
# On Linux, USB printer is typically /dev/usb/lp0.
# In simulation/development mode, set to "SIMULATOR" or empty.
PRINTER_DEVICE=/dev/usb/lp0
SIMULATION_MODE=false

# Template and Storage Directories
LABEL_DIR=/opt/label_system/labels
TEMPLATE_DIR=/opt/label_system/templates

# Token and Generation Constraints (Guarantees Free-Tier Safety)
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.0
