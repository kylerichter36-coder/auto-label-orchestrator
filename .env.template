# ==============================================================================
# Autonomous Label Orchestrator - Environment Configuration Template
# Target Platform: Orange Pi PC Plus (Allwinner H3, 1GB DDR3 RAM, Armbian trixie)
# Service Unit   : autolabel.service
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit the active .env file containing real API keys to version control.
# - This template provides the complete configuration schema with masked keys.
# - On production Orange Pi hosts, ensure permissions are restricted: chmod 600 .env
# ==============================================================================

# Gemini Vision API Key Pool (10 keys for automated 429 failover & cooldown rotation)
# Format: Comma-separated list of 10 Google AI Studio API keys
GEMINI_API_KEYS=AIzaSyA_KEY01_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyB_KEY02_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyC_KEY03_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyD_KEY04_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyE_KEY05_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyF_KEY06_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyG_KEY07_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyH_KEY08_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyI_KEY09_MASKED_EXAMPLE_KEY_FOR_DOCS,AIzaSyJ_KEY10_MASKED_EXAMPLE_KEY_FOR_DOCS

# Gemini Vision Model Configuration
GEMINI_MODEL=gemini-3.8-flash
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.0

# Network Scanner Influx (Lexmark MX511 Direct Ethernet SMTP Tether)
# Bound to local port 2525 for in-memory PDF rasterization and classification
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
DIRECT_ETH_IP=192.168.50.1
SCANNER_IP=192.168.50.2

# Enterprise Industrial Web Dashboard
# BarTender-style dark theme interface on port 8080 (zero emojis, zero fake readings)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Physical Thermal Transfer Label Printer (Argox OS-214)
# Direct raw character device node streaming 203.2 DPI PPLB binary commands
PRINTER_DEVICE=/dev/usb/lp0
SIMULATION_MODE=false

# Template and Label Asset Directories
LABEL_DIR=/opt/label_system/labels
TEMPLATE_DIR=/opt/label_system/templates

# Dedicated 64GB MicroSD Non-Volatile Backup & Audit Storage
# Partition mount for SQLite state, JSONL transaction logs, and rollback snapshots
SDCARD_MOUNT=/mnt/sdcard_backup
FALLBACK_STORAGE_DIR=/opt/label_system/backup_storage
AUDIT_LOG_DIR=/mnt/sdcard_backup/audit_logs
